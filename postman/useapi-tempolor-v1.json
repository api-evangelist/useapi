              "type": "text",
              "disabled": true
            },
            {
              "key": "bpm",
              "value": "",
              "description": "Optional, the beats per minute for the generated music. Valid range: 50-190. Default is determined by the prompt and style.",
              "type": "text",
              "disabled": true
            },
            {
              "key": "chord",
              "value": "",
              "description": "Optional, chord progression for the composition. Maximum length 200 characters.",
              "type": "text",
              "disabled": true
            },
            {
              "key": "replyUrl",
              "value": "",
              "description": "Optional, a callback URL that will be called with generation progress updates. Maximum length 1024 characters.",
              "type": "text",
              "disabled": true
            },
            {
              "key": "replyRef",
              "value": "",
              "description": "Optional, a reference ID that will be included in the callback requests. Maximum length 1024 characters.",
              "type": "text",
              "disabled": true
            },
            {
              "key": "maxJobs",
              "value": "",
              "description": "Optional override for account maxJobs.",
              "type": "text",
              "disabled": true
            }
          ]
