{
  "opencollection": "1.0.0",
  "info": {
    "name": "Dreamina API v1 by useapi.net",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "dreamina",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET accounts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.useapi.net/v1/dreamina/accounts"
          },
          "docs": "List all configured Dreamina accounts.\n\n[Documentation](https://useapi.net/docs/api-dreamina-v1/get-dreamina-accounts)"
        },
        {
          "info": {
            "name": "POST accounts",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.useapi.net/v1/dreamina/accounts",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Configure your Dreamina account for API access using email and password credentials.\n\nSee [Setup Dreamina](https://useapi.net/docs/start-here/setup-dreamina) for detailed instructions.\n\n[Documentation](https://useapi.net/docs/api-dreamina-v1/post-dreamina-accounts)"
        },
        {
          "info": {
            "name": "GET accounts/<account>",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.useapi.net/v1/dreamina/accounts/:account",
            "params": [
              {
                "name": "account",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get configuration details for a specific Dreamina account, including session status, available models, and credit balance. Can also be called once a day to claim free daily credits.\n\n[Documentation](https://useapi.net/docs/api-dreamina-v1/get-dreamina-accounts-account)"
        },
        {
          "info": {
            "name": "DELETE accounts/<account>",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.useapi.net/v1/dreamina/accounts/:account",
            "params": [
              {
                "name": "account",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a configured Dreamina account. Removes the account from your configuration and cleans up any executing job entries.\n\n[Documentation](https://useapi.net/docs/api-dreamina-v1/delete-dreamina-accounts-account)"
        },
        {
          "info": {
            "name": "GET assets/<account>",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.useapi.net/v1/dreamina/assets/:account",
            "params": [
              {
                "name": "account",
                "value": "",
                "type": "path"
              },
              {
                "name": "count",
                "value": "20",
                "type": "query",
                "description": "Number of assets to return (1-100, default: 20). Optional."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Pagination cursor from previous response's nextOffset. Optional."
              }
            ]
          },
          "docs": "List generation history (images and videos) for a specific account. Returns assets with their URLs, dimensions, and reusable assetRef values for POST /images or as in POST /videos.\n\n[Documentation](https://useapi.net/docs/api-dreamina-v1/get-dreamina-assets-account)"
        },
        {
          "info": {
            "name": "POST assets/<account>",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.useapi.net/v1/dreamina/assets/:account",
            "params": [
              {
                "name": "account",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Upload images to Dreamina for use as reference frames in video and image generation.\n\nSupports JPEG, PNG, and WebP formats up to 10 MB. Returns assetRef for use in POST /videos and POST /images.\n\n[Documentation](https://useapi.net/docs/api-dreamina-v1/post-dreamina-assets-account)"
        },
        {
          "info": {
            "name": "DELETE assets/<assetId>",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.useapi.net/v1/dreamina/assets/:assetId",
            "params": [
              {
                "name": "assetId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a specific asset (image or video) from generation history.\n\n[Documentation](https://useapi.net/docs/api-dreamina-v1/delete-dreamina-assets-assetid)"
        },
        {
          "info": {
            "name": "POST videos",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.useapi.net/v1/dreamina/videos",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "prompt",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "model",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "account",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "ratio",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "duration",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "resolution",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "firstFrameRef",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "endFrameRef",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "frame_1_imageRef",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "frame_1_prompt",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "frame_1_duration",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "frame_2_imageRef",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "frame_2_prompt",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "frame_2_duration",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "replyUrl",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "replyRef",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "maxJobs",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Generate videos using Dreamina AI models. Supports text-to-video, first frame (I2V), end frame, and multi-frame keyframe modes.\n\nAsync by default — returns immediately with a job ID. Poll GET /videos/<jobid> for completion.\n\n[Documentation](https://useapi.net/docs/api-dreamina-v1/post-dreamina-videos)"
        },
        {
          "info": {
            "name": "GET videos/<jobid>",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.useapi.net/v1/dreamina/videos/:jobid",
            "params": [
              {
                "name": "jobid",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve the status and result of a video generation job. Poll this endpoint after POST /videos. Jobs are retained for 30 days.\n\nWhen status is 'completed', response.videoUrl contains the download URL.\n\n[Documentation](https://useapi.net/docs/api-dreamina-v1/get-dreamina-videos-jobid)"
        },
        {
          "info": {
            "name": "POST videos/upscale",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.useapi.net/v1/dreamina/videos/upscale",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "jobid",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "replyUrl",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "replyRef",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "maxJobs",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Upscale a generated video to 2x resolution (super resolution). Doubles width and height — 720p becomes 1440p, 1080p becomes 4K. Each video can only be upscaled once.\n\nPoll GET /videos/<jobid> for the upscaled result.\n\n[Documentation](https://useapi.net/docs/api-dreamina-v1/post-dreamina-videos-upscale)"
        },
        {
          "info": {
            "name": "POST videos/interpolate",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.useapi.net/v1/dreamina/videos/interpolate",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "jobid",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "fps",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "replyUrl",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "replyRef",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "maxJobs",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Interpolate a generated video to 30 or 60 FPS (from 24 FPS source). Works on both original and upscaled videos. Each video can only be interpolated once.\n\nPoll GET /videos/<jobid> for the interpolated result.\n\n[Documentation](https://useapi.net/docs/api-dreamina-v1/post-dreamina-videos-interpolate)"
        },
        {
          "info": {
            "name": "POST images",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.useapi.net/v1/dreamina/images",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "prompt",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "model",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "account",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "ratio",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "resolution",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "imageRef_1",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "imageRef_2",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "imageRef_3",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "imageStrength",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "replyUrl",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "replyRef",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "maxJobs",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Generate images using Dreamina AI models from text prompts with optional reference images. Each generation produces up to 4 images.\n\nAsync by default — returns immediately with a job ID. Poll GET /images/<jobid> for completion.\n\n[Documentation](https://useapi.net/docs/api-dreamina-v1/post-dreamina-images)"
        },
        {
          "info": {
            "name": "GET images/<jobid>",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.useapi.net/v1/dreamina/images/:jobid",
            "params": [
              {
                "name": "jobid",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve the status and result of an image generation or upscale job. Poll this endpoint after POST /images or POST /images/upscale. Jobs are retained for 30 days.\n\nWhen status is 'completed', response.images contains the generated images with URLs and assetRef values.\n\n[Documentation](https://useapi.net/docs/api-dreamina-v1/get-dreamina-images-jobid)"
        },
        {
          "info": {
            "name": "POST images/upscale",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.useapi.net/v1/dreamina/images/upscale",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Upscale a generated image to higher resolution (2K, 4K, or 8K). Requires a completed image generation job from POST /images.\n\nPoll GET /images/<jobid> for the result.\n\n[Documentation](https://useapi.net/docs/api-dreamina-v1/post-dreamina-images-upscale)"
        },
        {
          "info": {
            "name": "GET scheduler",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.useapi.net/v1/dreamina/scheduler"
          },
          "docs": "List all currently executing (in-progress) image and video generation jobs, grouped by account.\n\n[Documentation](https://useapi.net/docs/api-dreamina-v1/get-dreamina-scheduler)"
        },
        {
          "info": {
            "name": "DELETE scheduler/<jobid>",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.useapi.net/v1/dreamina/scheduler/:jobid",
            "params": [
              {
                "name": "jobid",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Cancel an executing job. If the job is still in 'created' status, it will be marked as failed with reason 'Cancelled by user'.\n\n[Documentation](https://useapi.net/docs/api-dreamina-v1/delete-dreamina-scheduler-jobid)"
        }
      ]
    }
  ],
  "bundled": true
}